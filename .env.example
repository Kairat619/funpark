# Optional production-only script injection. Both values must be set to enable it.
TEMPLATE_BANNER_SCRIPT_URL=
TEMPLATE_REDIRECT_URL=

# URL of the deployed Telegram relay worker (see worker/ and README).
# Leave blank to skip sending form submissions (e.g. local development).
VITE_LEAD_ENDPOINT=

# WhatsApp number that receives price list requests: digits only, with country
# code, no + or spaces. Defaults to the test number 77024883117 when blank.
VITE_WHATSAPP_NUMBER=
